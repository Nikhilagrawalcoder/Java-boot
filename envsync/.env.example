# --- Database ---
# Postgres connection string (see docker-compose.yml for a local instance)
DATABASE_URL="postgresql://envsync:envsync@localhost:5432/envsync"

# --- Auth.js / NextAuth ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# --- Encryption ---
# Encrypts the GitHub access token at rest. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=""

# --- GitHub OAuth App ---
# Create at https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
# Scopes requested: read:user, user:email, repo (read-only usage — see docs/github-permissions.md)
GITHUB_ID=""
GITHUB_SECRET=""

# --- GitHub webhook (PR checks) ---
# Any random string; used to verify webhook payloads actually came from GitHub.
# Generate with: openssl rand -hex 20
GITHUB_WEBHOOK_SECRET=""
