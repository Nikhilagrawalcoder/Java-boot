{
  "name": "@envsync/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript SDK for the EnvSync REST API.",
  "license": "MIT",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs && npm run build:types",
    "build:esm": "esbuild src/index.ts --bundle --platform=neutral --format=esm --outfile=dist/index.mjs",
    "build:cjs": "esbuild src/index.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist/index.cjs",
    "build:types": "tsc --emitDeclarationOnly --declaration --outDir dist",
    "prepublishOnly": "npm run build",
    "dev": "tsx src/index.ts"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
