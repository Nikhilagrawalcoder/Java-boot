# Reference file for everything the Envexa free early access funnel touches.
# None of this is auto-loaded — index.html is a static file with no
# build step, so each value below has to be copied by hand to where
# it's actually used. See the comment above each group.
#
# Copy this to .env and fill in real values; .env is gitignored.

# --- Supabase (leads storage) ---------------------------------------
# Dashboard -> Settings -> API. Copy into the SUPABASE_URL /
# SUPABASE_ANON_KEY constants in index.html's <script> block.
# The anon key is *meant* to be public in client-side code — the RLS
# policy in supabase-preorder-leads.sql restricts it to insert-only.
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_ANON_KEY="YOUR-ANON-PUBLIC-KEY"

# --- Gmail (welcome email, sent by the Edge Function) ----------------
# Turn on 2-Step Verification on this account, then generate an App
# Password at https://myaccount.google.com/apppasswords — NOT your
# normal Gmail password. This copy is for reference only; the value
# that actually matters is set on Supabase's side:
#   supabase secrets set GMAIL_USER=... GMAIL_APP_PASSWORD=...
# (also mirrored in envsync/supabase/.env, which the CLI reads from)
GMAIL_USER="you@gmail.com"
GMAIL_APP_PASSWORD="xxxxxxxxxxxxxxxx"

